<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MeterHub</RootNamespace>
  </PropertyGroup>

  <!-- Copy the sample CSVs next to the built program, so the path works
       from `dotnet run` and from F5 regardless of the current folder. -->
  <ItemGroup>
    <None Include="..\data\*.csv" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
